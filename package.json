{
  "name": "chorus",
  "version": "1.4.2",
  "private": true,
  "description": "Chorus — live lyrics for OBS, driven by Windows SMTC (smtc-bridge), with multi-platform original-lyrics lookup.",
  "keywords": [
    "obs",
    "lyrics",
    "smtc",
    "now-playing",
    "windows",
    "overlay",
    "lrc"
  ],
  "license": "MIT",
  "author": "Chorus contributors",
  "homepage": "https://github.com/wixicle727/Chorus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wixicle727/Chorus.git"
  },
  "bugs": {
    "url": "https://github.com/wixicle727/Chorus/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:tray": "node src/index.js --tray",
    "stop": "node src/index.js --quit",
    "build:exe": "node tools/build/build-exe.mjs",
    "build:installer": "node tools/build/build-installer.mjs",
    "build": "node tools/build/build-exe.mjs && node tools/build/build-installer.mjs",
    "logo": "python tools/logo/make_logo.py",
    "test": "node test/run.js",
    "test:offline": "node test/run.js --offline",
    "test:engine": "node test/engine.js",
    "test:nowplaying": "node test/nowplaying.js",
    "test:karaoke": "node test/karaoke.js",
    "test:ui": "node test/ui.js",
    "test:control": "node test/control.js",
    "test:updater": "node test/updater.js",
    "test:all": "node test/run.js --offline && node test/engine.js && node test/nowplaying.js && node test/control.js && node test/karaoke.js && node test/i18n.js && node test/updater.js",
    "test:i18n": "node test/i18n.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "win32"
  ],
  "devDependencies": {
    "innosetup-compiler": "^6.3.1",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^5.0.2",
    "resedit": "^3.1.0"
  }
}
