# Runtime data. Everything here is generated on first run and is specific to your
# machine, so none of it belongs in version control.
data/
*.pid

# Logs
*.log
logs/

# Editing/OS noise
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Node (postject is a build-time devDependency for the .exe; runtime deps stay at 0)
node_modules/
npm-debug.log*

# Release staging, produced by the release workflow and tools/build
build/

# npm cache, when a restricted machine has to keep it inside the project
.npm-cache/

# Local scratch
*.local
.DS_Store
